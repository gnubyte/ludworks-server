{
  "control": "control",
  "files": [
    { "src": "${BINARY}", "dst": "/usr/bin/ludworks", "mode": "0755" },
    { "src": "ludworks.service", "dst": "/usr/lib/systemd/system/ludworks.service", "mode": "0644" },
    { "src": "config.json", "dst": "/etc/ludworks/config.json", "mode": "0640", "conffile": true },
    { "src": "copyright", "dst": "/usr/share/doc/ludworks/copyright", "mode": "0644" },
    { "src": "bind-privileged-port.conf", "dst": "/usr/share/doc/ludworks/examples/bind-privileged-port.conf", "mode": "0644" }
  ],
  "dirs": [
    { "dst": "/etc/ludworks", "mode": "0755" }
  ],
  "scripts": {
    "postinst": "postinst",
    "prerm": "prerm",
    "postrm": "postrm"
  }
}
