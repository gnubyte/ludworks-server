# Text files are stored and checked out with LF line endings on every platform.
* text=auto eol=lf

# Windows-native files keep CRLF.
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.iss text eol=crlf
packaging/windows/*.txt text eol=crlf

# Debian maintainer scripts, the control file and the systemd unit must stay LF
# (tools/mkdeb refuses CRLF in maintainer scripts).
packaging/deb/** text eol=lf
*.sh text eol=lf

# Vendored, checksummed third-party files: never touch their bytes.
internal/apidocs/swagger-ui/** -text

# Binary files
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
